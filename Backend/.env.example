# =============================================================================
# CineSeat API — environment template (Srinivas Lakavath's ticket booking system)
# Copy to .env and fill in real values. Never commit secrets.
# =============================================================================

# Server Configuration
PORT=8000
NODE_ENV=development

# Database — local MongoDB OR Atlas (use one)
# Local example:
# MONGODB_URI=mongodb://localhost:27017/cineseat
# Atlas example (URL-encode special chars in password, e.g. @ -> %40):
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/TICKET-BOOKING-SYSTEM?retryWrites=true&w=majority&appName=Cluster0
# Aliases also accepted by the server:
# MONGO_URI_ATLAS=...
# MONGO_URI=...

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=7d

# Client Configuration (CineSeat web app)
CLIENT_URL=http://localhost:5173

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase Auth (Spark / free plan) — Web API key from Firebase project settings
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Payment Gateway - Cashfree (currently in use)
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret

# Payment Gateway - Razorpay (legacy/alternative)
RAZORPAY_API_KEY=your-razorpay-api-key
RAZORPAY_API_SECRET=your-razorpay-api-secret

# Security Settings
# Password hashing uses bcrypt with 12 salt rounds (handled in code)

# Rate Limiting (optional overrides in security.config.js)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# HTTPS (for production)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
