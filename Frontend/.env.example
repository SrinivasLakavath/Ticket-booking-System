# =============================================================================
# CineSeat frontend — environment template
# Srinivas Lakavath's ticket booking system (React + Vite)
# Copy to .env and fill values. Never commit real secrets.
# =============================================================================

# CineSeat API base URL (Express backend)
VITE_API_URL=http://localhost:8000

# Firebase Auth (Spark/free) + optional Analytics
# Enable Email/Password (+ Google) in Console → Build → Authentication
# Storage needs Blaze on new projects — use image URLs instead for free tier
VITE_REACT_APP_FIREBASE_API_KEY=
VITE_REACT_APP_FIREBASE_AUTH_DOMAIN=
VITE_REACT_APP_FIREBASE_PROJECT_ID=
VITE_REACT_APP_FIREBASE_STORAGE_BUCKET=
VITE_REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
VITE_REACT_APP_FIREBASE_APP_ID=
VITE_REACT_APP_FIREBASE_MEASUREMENT_ID=
